{
  "name": "honest-reps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:rls": "vitest run --project rls",
    "e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node --env-file-if-exists=.env.local scripts/seed.mts --sample",
    "db:migrate": "supabase migration up",
    "db:push": "supabase db push",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mts",
    "env:local": "node scripts/local-env.mts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "radix-ui": "^1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "shadcn": "^4.21.4",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.34.7"
}
