# Copy to .env.local. For local development, `pnpm env:local` fills the
# Supabase values from the running local stack.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://127.0.0.1:3000

# The account seeded as the coach (pnpm db:seed).
COACH_EMAIL=

# Used from M1 onward.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
USDA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
