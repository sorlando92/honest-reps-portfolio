# Copy to .env.local. For local development, `pnpm env:local` fills the
# Supabase values from the running local stack.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://127.0.0.1:3000

# The account seeded as the coach (pnpm db:seed).
COACH_EMAIL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Only needed with FDC_SEARCH=api; search uses the local FDC copy by default.
USDA_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (RFC 8292), mailto: or https:
VAPID_SUBJECT=

# Invite emails (Resend), and the shared secret the scheduled jobs send.
RESEND_API_KEY=
JOBS_SECRET=

# Billing is post-MVP; nothing reads these yet.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Error monitoring (Vercel only; leave empty locally and Sentry stays off).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
